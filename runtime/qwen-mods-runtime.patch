+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { mkdir, readFile, rename, unlink, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import lockfile from 'proper-lockfile';
+import type { Json } from './api.js';
+
+export class JsonStore {
+  constructor(private readonly file: string) {}
+
+  private async read(): Promise<Record<string, Json>> {
+    try {
+      const data: unknown = JSON.parse(await readFile(this.file, 'utf8'));
+      if (!data || typeof data !== 'object' || Array.isArray(data))
+        throw new Error(`Invalid mod store: ${this.file}`);
+      return data as Record<string, Json>;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return {};
+      throw error;
+    }
+  }
+
+  async get<T extends Json>(key: string, fallback: T): Promise<T> {
+    const data = await this.read();
+    return Object.hasOwn(data, key) ? (data[key] as T) : fallback;
+  }
+
+  async set(key: string, value: Json): Promise<void> {
+    await this.update(key, null, () => value);
+  }
+
+  async update<T extends Json>(
+    key: string,
+    fallback: T,
+    change: (value: T) => T,
+  ): Promise<T> {
+    await mkdir(path.dirname(this.file), { recursive: true });
+    const release = await lockfile.lock(this.file, {
+      realpath: false,
+      retries: { retries: 20, minTimeout: 10, maxTimeout: 100 },
+    });
+    const temporary = `${this.file}.${randomUUID()}.tmp`;
+    try {
+      const data = await this.read();
+      const value = change(
+        Object.hasOwn(data, key) ? (data[key] as T) : fallback,
+      );
+      Object.defineProperty(data, key, {
+        value,
+        enumerable: true,
+        configurable: true,
+      });
+      await writeFile(temporary, JSON.stringify(data, null, 2), {
+        mode: 0o600,
+      });
+      await rename(temporary, this.file);
+      return value;
+    } finally {
+      await unlink(temporary).catch(() => undefined);
+      await release();
+    }
+  }
+}
