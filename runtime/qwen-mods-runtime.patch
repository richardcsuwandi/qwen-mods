@@ -0,0 +1,637 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { readFile, realpath } from 'node:fs/promises';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { randomUUID } from 'node:crypto';
+import { execFile } from 'node:child_process';
+import type { ComponentType } from 'react';
+import type { Config } from '@qwen-code/qwen-code-core';
+import { Storage } from '@qwen-code/qwen-code-core/config/storage.js';
+import { HookEventName } from '@qwen-code/qwen-code-core/hooks/types.js';
+import type { FunctionHookCallback } from '@qwen-code/qwen-code-core/hooks/types.js';
+import { CommandKind, type SlashCommand } from '../ui/commands/types.js';
+import type {
+  Dispose,
+  ModEvent,
+  ModManifest,
+  ModSession,
+  ModSlot,
+  ModViewProps,
+  QwenModAPI,
+  QwenModModule,
+} from './api.js';
+import { JsonStore } from './json-store.js';
+
+interface ModRecord {
+  manifest: ModManifest;
+  directory: string;
+  abort: AbortController;
+  cleanups: Set<Dispose>;
+  commands: SlashCommand[];
+  views: Array<{
+    slot: ModSlot;
+    component: ComponentType<ModViewProps>;
+    key: string;
+  }>;
+  listeners: Map<
+    ModEvent,
+    Set<(session: Readonly<ModSession>) => void | Promise<void>>
+  >;
+  hooks: Array<{
+    event: HookEventName;
+    callback: FunctionHookCallback;
+    matcher: string;
+    timeout?: number;
+    remove?: Dispose;
+  }>;
+}
+
+export interface ModHost {
+  ui: Pick<QwenModAPI['ui'], 'React' | 'Box' | 'Text' | 'Button'>;
+  submit(text: string): void;
+  notify(text: string, level: 'info' | 'warning' | 'error'): void;
+  context: QwenModAPI['session']['context'];
+  commandsChanged(): void;
+}
+
+export class ModRuntime {
+  private records = new Map<string, ModRecord>();
+  private states = new Map<string, Map<string, unknown>>();
+  private subscribers = new Set<() => void>();
+  private revision = 0;
+  private host?: ModHost;
+  private snapshot?: Readonly<ModSession>;
+  private queue: Promise<unknown> = Promise.resolve();
+  private readonly registry: JsonStore;
+  private disposed = false;
+
+  constructor(
+    readonly config: Config,
+    private readonly root = path.join(Storage.getGlobalQwenDir(), 'mods'),
+  ) {
+    this.registry = new JsonStore(path.join(root, 'enabled.json'));
+  }
+
+  subscribe = (callback: () => void): Dispose => {
+    this.subscribers.add(callback);
+    return () => {
+      this.subscribers.delete(callback);
+    };
+  };
+  getRevision = (): number => this.revision;
+  invalidate = (): void => {
+    this.revision++;
+    this.subscribers.forEach((callback) => callback());
+  };
+
+  attach(host: ModHost): void {
+    this.host = host;
+    this.disposed = false;
+  }
+
+  private report(id: string, error: unknown): void {
+    this.host?.notify(
+      `Mod ${id}: ${error instanceof Error ? error.message : String(error)}`,
+      'error',
+    );
+  }
+
+  private invoke(
+    record: ModRecord,
+    callback: () => void | Promise<void>,
+  ): void {
+    if (record.abort.signal.aborted) return;
+    try {
+      void Promise.resolve(callback()).catch((error: unknown) => {
+        if (!record.abort.signal.aborted)
+          this.report(record.manifest.id, error);
+      });
+    } catch (error) {
+      this.report(record.manifest.id, error);
+    }
+  }
+
+  private emit(
+    record: ModRecord,
+    event: ModEvent,
+    snapshot: Readonly<ModSession>,
+  ): void {
+    record.listeners
+      .get(event)
+      ?.forEach((callback) => this.invoke(record, () => callback(snapshot)));
+  }
+
+  updateSession(snapshot: ModSession): void {
+    const previous = this.snapshot;
+    if (previous && JSON.stringify(previous) === JSON.stringify(snapshot))
+      return;
+    this.snapshot = Object.freeze({ ...snapshot });
+    for (const record of this.records.values()) {
+      if (previous?.id !== snapshot.id) {
+        if (previous) this.emit(record, 'session.end', previous);
+        this.bindHooks(record);
+        this.emit(record, 'session.start', this.snapshot);
+      }
+      if (previous?.id === snapshot.id && previous.busy !== snapshot.busy)
+        this.emit(
+          record,
+          snapshot.busy ? 'turn.start' : 'turn.end',
+          this.snapshot,
+        );
+      this.emit(record, 'session.update', this.snapshot);
+    }
+    this.invalidate();
+  }
+
+  getSession(): Readonly<ModSession> {
+    if (!this.snapshot) throw new Error('Mod session is not ready');
+    return this.snapshot;
+  }
+
+  getViews(slot: ModSlot) {
+    return [...this.records.values()].flatMap((r) =>
+      r.views.filter((v) => v.slot === slot),
+    );
+  }
+
+  getCommands(): SlashCommand[] {
+    return [...this.records.values()].flatMap((record) => record.commands);
+  }
+
+  private bindHooks(record: ModRecord): void {
+    const system = this.config.getHookSystem();
+    const session = this.config.getSessionId();
+    for (const hook of record.hooks) {
+      hook.remove?.();
+      hook.remove = undefined;
+      if (!system || system.isManaged()) continue;
+      const id = system.addFunctionHook(
+        session,
+        hook.event,
+        hook.matcher,
+        async (input, context) => {
+          if (
+            record.abort.signal.aborted ||
+            this.config.getSessionId() !== session ||
+            input.session_id !== session ||
+            input.agent_id
+          )
+            return undefined;
+          return hook.callback(input, context);
+        },
+        `Mod ${record.manifest.id} hook failed`,
+        { name: record.manifest.id, timeout: hook.timeout ?? 10_000 },
+      );
+      hook.remove = () => {
+        system.removeFunctionHook(session, hook.event, id);
+      };
+    }
+  }
+
+  private api(record: ModRecord): QwenModAPI {
+    const host = this.host!;
+    const id = record.manifest.id;
+    const signal = record.abort.signal;
+    const assertActive = () => {
+      if (signal.aborted) throw new Error(`Mod ${id} is unloaded`);
+    };
+    const track = (cleanup: Dispose): Dispose => {
+      record.cleanups.add(cleanup);
+      return () => {
+        if (record.cleanups.delete(cleanup)) cleanup();
+      };
+    };
+    let state = this.states.get(id);
+    if (!state) {
+      state = new Map();
+      this.states.set(id, state);
+    }
+    const store = new JsonStore(path.join(this.root, 'data', `${id}.json`));
+    return {
+      version: 1,
+      id,
+      directory: record.directory,
+      signal,
+      command: (name, description, handler) => {
+        assertActive();
+        if (
+          !/^[a-z][a-z0-9-]{0,63}$/.test(name) ||
+          record.commands.some((c) => c.name === name)
+        )
+          throw new Error(`Invalid or duplicate command: ${name}`);
+        const command: SlashCommand = {
+          name,
+          description,
+          kind: CommandKind.BUILT_IN,
+          extensionName: id,
+          supportedModes: ['interactive'],
+          modelInvocable: false,
+          canRunDuringStreaming: true,
+          action: async () => undefined,
+        };
+        command.action = async (_context, args) => {
+          try {
+            assertActive();
+            const content = await handler(args);
+            if (signal.aborted || content === undefined) return;
+            return { type: 'message', messageType: 'info', content };
+          } catch (error) {
+            if (signal.aborted) return;
+            return {
+              type: 'message',
+              messageType: 'error',
+              content: `Mod ${id}: ${error instanceof Error ? error.message : String(error)}`,
+            };
+          }
+        };
+        record.commands.push(command);
+        host.commandsChanged();
+        return track(() => {
+          record.commands = record.commands.filter((c) => c !== command);
+          host.commandsChanged();
+        });
+      },
+      runCommand: (name, args = '') => {
+        assertActive();
+        if (!/^[a-z][a-z0-9.-]*$/.test(name))
+          throw new Error('Invalid command name');
+        host.submit(`/${name}${args ? ` ${args}` : ''}`);
+      },
+      prompt: (text) => {
+        assertActive();
+        host.submit(text);
+      },
+      on: (event, callback) => {
+        assertActive();
+        const listeners = record.listeners.get(event) ?? new Set();
+        listeners.add(callback);
+        record.listeners.set(event, listeners);
+        return track(() => {
+          listeners.delete(callback);
+        });
+      },
+      hook: (event, callback, options = {}) => {
+        assertActive();
+        const system = this.config.getHookSystem();
+        if (!system || system.isManaged() || this.config.getDisableAllHooks())
+          throw new Error(
+            'Native mod hooks require local Qwen hooks to be enabled',
+          );
+        if (!Object.values(HookEventName).includes(event as HookEventName))
+          throw new Error(`Unknown hook: ${event}`);
+        const hook: ModRecord['hooks'][number] = {
+          event: event as HookEventName,
+          callback,
+          matcher: options.matcher ?? '*',
+          timeout: options.timeout,
+        };
+        record.hooks.push(hook);
+        this.bindHooks(record);
+        return track(() => {
+          hook.remove?.();
+          record.hooks = record.hooks.filter((h) => h !== hook);
+        });
+      },
+      session: {
+        get: () => {
+          assertActive();
+          return this.getSession();
+        },
+        context: () => {
+          assertActive();
+          return host.context();
+        },
+      },
+      state: {
+        get: <T>(key: string, fallback: T) => {
+          assertActive();
+          return state!.has(key) ? (state!.get(key) as T) : fallback;
+        },
+        set: (key, value) => {
+          assertActive();
+          state!.set(key, value);
+          this.invalidate();
+        },
+      },
+      store: {
+        get: (key, fallback) => {
+          assertActive();
+          return store.get(key, fallback);
+        },
+        set: (key, value) => {
+          assertActive();
+          return store.set(key, value);
+        },
+        update: (key, fallback, change) => {
+          assertActive();
+          return store.update(key, fallback, change);
+        },
+      },
+      ui: {
+        ...host.ui,
+        Button: (props) =>
+          host.ui.React.createElement(host.ui.Button, {
+            ...props,
+            onPress: () => this.invoke(record, props.onPress),
+          }),
+        slot: (slot, component) => {
+          assertActive();
+          if (!['abovePrompt', 'belowPrompt', 'footer'].includes(slot))
+            throw new Error(`Unknown UI slot: ${slot}`);
+          const view = { slot, component, key: `${id}:${randomUUID()}` };
+          record.views.push(view);
+          this.invalidate();
+          return track(() => {
+            record.views = record.views.filter((v) => v !== view);
+            this.invalidate();
+          });
+        },
+        notify: (text, level = 'info') => {
+          assertActive();
+          host.notify(text, level);
+        },
+        invalidate: () => {
+          if (!signal.aborted) this.invalidate();
+        },
+      },
+      timers: {
+        every: (ms, callback) => {
+          assertActive();
+          if (!Number.isFinite(ms) || ms < 100)
+            throw new Error('Timer interval must be at least 100 ms');
+          const timer = setInterval(() => this.invoke(record, callback), ms);
+          timer.unref();
+          return track(() => clearInterval(timer));
+        },
+      },
+      http: {
+        fetch: (url, options = {}) => {
+          assertActive();
+          return fetch(url, {
+            ...options,
+            signal: AbortSignal.any([
+              signal,
+              options.signal ?? AbortSignal.timeout(30_000),
+            ]),
+          });
+        },
+      },
+      process: {
+        run: (file, args = [], options = {}) => {
+          assertActive();
+          return new Promise((resolve, reject) => {
+            execFile(
+              file,
+              args,
+              {
+                cwd: options.cwd ?? this.config.getTargetDir(),
+                timeout: options.timeout ?? 30_000,
+                maxBuffer: 1024 * 1024,
+                encoding: 'utf8',
+                signal,
+              },
+              (error, stdout, stderr) => {
+                if (error) reject(error);
+                else resolve({ stdout, stderr });
+              },
+            );
+          });
+        },
+      },
+      experimental: { config: this.config },
+    };
+  }
+
+  private async load(directory: string): Promise<string> {
+    if (this.config.isSafeMode() || this.config.getBareMode())
+      throw new Error('Mods are disabled in safe or bare mode');
+    if (!this.host || !this.snapshot || this.disposed)
+      throw new Error(
+        'Mods are available after the interactive Ink session is ready',
+      );
+    const root = await realpath(
+      path.resolve(this.config.getTargetDir(), directory),
+    );
+    const manifest = JSON.parse(
+      await readFile(path.join(root, 'qwen-mod.json'), 'utf8'),
+    ) as ModManifest;
+    if (
+      !manifest ||
+      manifest.apiVersion !== 1 ||
+      typeof manifest.id !== 'string' ||
+      !/^[a-z][a-z0-9-]{0,63}$/.test(manifest.id) ||
+      typeof manifest.entry !== 'string'
+    )
+      throw new Error(
+        'Invalid qwen-mod.json. Expected id, apiVersion: 1 and entry',
+      );
+    if (this.records.has(manifest.id))
+      throw new Error(
+        `Mod ${manifest.id} is already loaded. Use /mods reload ${manifest.id}`,
+      );
+    const entry = await realpath(path.resolve(root, manifest.entry));
+    const relative = path.relative(root, entry);
+    if (
+      relative.startsWith(`..${path.sep}`) ||
+      relative === '..' ||
+      path.isAbsolute(relative) ||
+      !/\.(mjs|js)$/.test(entry)
+    )
+      throw new Error(
+        'Mod entry must be a .mjs or .js file inside its directory',
+      );
+    if (this.disposed) throw new Error('Mod loading cancelled');
+    const record: ModRecord = {
+      manifest,
+      directory: root,
+      abort: new AbortController(),
+      cleanups: new Set(),
+      commands: [],
+      views: [],
+      listeners: new Map(),
+      hooks: [],
+    };
+    this.records.set(manifest.id, record);
+    try {
+      const module = (await import(
+        `${pathToFileURL(entry).href}?qwen_mod=${randomUUID()}`
+      )) as QwenModModule;
+      if (record.abort.signal.aborted || this.disposed)
+        throw new Error('Mod loading cancelled');
+      if (typeof module.register !== 'function')
+        throw new Error('Mod entry must export register(api)');
+      const cleanup = await module.register(this.api(record));
+      if (cleanup) {
+        if (typeof cleanup !== 'function')
+          throw new Error(
+            'register must return a cleanup function or undefined',
+          );
+        if (record.abort.signal.aborted) cleanup();
+        else record.cleanups.add(cleanup);
+      }
+      if (record.abort.signal.aborted || this.disposed)
+        throw new Error('Mod loading cancelled');
+      this.emit(record, 'session.start', this.getSession());
+      this.emit(record, 'session.update', this.getSession());
+      this.invalidate();
+      this.host.commandsChanged();
+      return manifest.id;
+    } catch (error) {
+      this.unload(manifest.id);
+      throw error;
+    }
+  }
+
+  private unload(id: string): void {
+    const record = this.records.get(id);
+    if (!record) return;
+    record.abort.abort();
+    for (const cleanup of [...record.cleanups].reverse()) {
+      try {
+        cleanup();
+      } catch (error) {
+        this.report(id, error);
+      }
+    }
+    record.cleanups.clear();
+    this.records.delete(id);
+    this.invalidate();
+    this.host?.commandsChanged();
+  }
+
+  private async enabled(): Promise<Record<string, string>> {
+    const entries = await this.registry.get('entries', {});
+    if (
+      !entries ||
+      typeof entries !== 'object' ||
+      Array.isArray(entries) ||
+      Object.entries(entries).some(
+        ([id, p]) =>
+          !/^[a-z][a-z0-9-]{0,63}$/.test(id) ||
+          typeof p !== 'string' ||
+          !path.isAbsolute(p),
+      )
+    )
+      throw new Error('Invalid enabled mods registry');
+    return entries as Record<string, string>;
+  }
+
+  async start(): Promise<void> {
+    if (this.config.isSafeMode() || this.config.getBareMode()) return;
+    try {
+      for (const [expectedId, directory] of Object.entries(
+        await this.enabled(),
+      )) {
+        if (this.disposed) return;
+        try {
+          const manifest = JSON.parse(
+            await readFile(path.join(directory, 'qwen-mod.json'), 'utf8'),
+          ) as ModManifest;
+          if (manifest.id !== expectedId)
+            throw new Error(
+              'Enabled mod ID changed. Disable the old ID and enable the directory again',
+            );
+          await this.manage('load', directory);
+        } catch (error) {
+          this.report(expectedId, error);
+        }
+      }
+    } catch (error) {
+      this.report('registry', error);
+    }
+  }
+
+  manage(action: string, argument = ''): Promise<string> {
+    const task = this.queue.then(async () => {
+      if (this.disposed) throw new Error('Mod runtime is closed');
+      if (action === 'list') {
+        const enabled = await this.enabled();
+        const ids = new Set([...this.records.keys(), ...Object.keys(enabled)]);
+        return (
+          [...ids]
+            .map(
+              (id) =>
+                `${id}: ${this.records.has(id) ? 'loaded' : 'unloaded'}${enabled[id] ? ', enabled on startup' : ''}`,
+            )
+            .join('\n') ||
+          'No mods loaded. /mods load <directory> runs trusted local JavaScript with full Node.js access.'
+        );
+      }
+      if (!argument)
+        throw new Error(
+          'Usage: /mods list | load <directory> | enable <directory> | reload <id> | unload <id> | disable <id>',
+        );
+      if (action === 'load' || action === 'enable') {
+        const directory = await realpath(
+          path.resolve(this.config.getTargetDir(), argument),
+        );
+        const existing = [...this.records.values()].find(
+          (r) => r.directory === directory,
+        );
+        const id =
+          action === 'enable' && existing
+            ? existing.manifest.id
+            : await this.load(directory);
+        if (action === 'enable') {
+          try {
+            await this.enabled();
+            await this.registry.update('entries', {}, (entries) => ({
+              ...(entries as Record<string, string>),
+              [id]: directory,
+            }));
+          } catch (error) {
+            if (!existing) this.unload(id);
+            throw error;
+          }
+        }
+        return `${action === 'enable' ? 'Enabled' : 'Loaded'} ${id}. Trusted code has full Node.js access.`;
+      }
+      if (action === 'reload') {
+        const directory = this.records.get(argument)?.directory;
+        if (!directory) throw new Error(`Mod ${argument} is not loaded`);
+        this.unload(argument);
+        return `Reloaded ${await this.load(directory)}.`;
+      }
+      if (action === 'unload' || action === 'disable') {
+        if (action === 'disable') {
+          await this.enabled();
+          await this.registry.update('entries', {}, (entries) => {
+            const next = { ...(entries as Record<string, string>) };
+            delete next[argument];
+            return next;
+          });
+        } else if (!this.records.has(argument))
+          throw new Error(`Mod ${argument} is not loaded`);
+        this.unload(argument);
+        return `${action === 'disable' ? 'Disabled' : 'Unloaded'} ${argument}.`;
+      }
+      throw new Error(`Unknown mods action: ${action}`);
+    });
+    this.queue = task.catch(() => undefined);
+    return task;
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    if (this.snapshot)
+      for (const record of this.records.values())
+        this.emit(record, 'session.end', this.snapshot);
+    for (const id of this.records.keys()) this.unload(id);
+    this.host = undefined;
+  }
+}
+
+const runtimes = new WeakMap<Config, ModRuntime>();
+export function getModRuntime(config: Config): ModRuntime {
+  let runtime = runtimes.get(config);
+  if (!runtime) {
+    runtime = new ModRuntime(config);
+    runtimes.set(config, runtime);
+  }
+  return runtime;
+}
