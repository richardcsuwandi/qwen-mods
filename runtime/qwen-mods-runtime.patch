@@ -0,0 +1,51 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type { Config } from '@qwen-code/qwen-code-core';
+import { CommandKind, type SlashCommand } from '../ui/commands/types.js';
+import type { ICommandLoader } from '../services/types.js';
+import { getModRuntime } from './runtime.js';
+
+export class ModCommandLoader implements ICommandLoader {
+  constructor(private readonly config: Config | null) {}
+  async loadCommands(signal: AbortSignal): Promise<SlashCommand[]> {
+    if (!this.config || signal.aborted) return [];
+    const runtime = getModRuntime(this.config);
+    return [
+      {
+        name: 'mods',
+        description: 'Load, enable, reload or disable trusted JavaScript mods',
+        kind: CommandKind.BUILT_IN,
+        supportedModes: ['interactive'],
+        modelInvocable: false,
+        action: async (_context, args) => {
+          const match = args.trim().match(/^(\S+)(?:\s+([\s\S]+))?$/);
+          const action = match?.[1] ?? 'list';
+          let argument = match?.[2] ?? '';
+          if (
+            (argument.startsWith('"') && argument.endsWith('"')) ||
+            (argument.startsWith("'") && argument.endsWith("'"))
+          )
+            argument = argument.slice(1, -1);
+          try {
+            return {
+              type: 'message',
+              messageType: 'info',
+              content: await runtime.manage(action, argument),
+            };
+          } catch (error) {
+            return {
+              type: 'message',
+              messageType: 'error',
+              content: error instanceof Error ? error.message : String(error),
+            };
+          }
+        },
+      },
+      ...runtime.getCommands(),
+    ];
+  }
+}
