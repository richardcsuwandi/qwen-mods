+
+import { render } from 'ink-testing-library';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { ModHost } from './runtime.js';
+import { ModsHost } from './ModsHost.js';
+
+const mocks = vi.hoisted(() => ({
+  config: {
+    getTargetDir: () => '/test',
+    getContentGeneratorConfig: () => ({ contextWindowSize: 200000 }),
+  },
+  settings: { merged: {} },
+  ui: {
+    sessionStats: {
+      metrics: { models: {} },
+      sessionId: 'main',
+      lastPromptTokenCount: 0,
+    },
+    currentModel: 'test',
+    streamingState: 'idle',
+    history: [],
+    isConfigInitialized: true,
+    shellModeActive: false,
+    dialogsVisible: false,
+    embeddedShellFocused: false,
+    commandContext: { ui: { addItem: vi.fn() } },
+  },
+  actions: { handleFinalSubmit: vi.fn(), reloadCommands: vi.fn() },
+  runtime: {
+    attach: vi.fn(),
+    updateSession: vi.fn(),
+    start: vi.fn(),
+    dispose: vi.fn(),
+  },
+}));
+
+vi.mock('./runtime.js', () => ({ getModRuntime: () => mocks.runtime }));
+vi.mock('../ui/contexts/ConfigContext.js', () => ({
+  useConfig: () => mocks.config,
+}));
+vi.mock('../ui/contexts/SettingsContext.js', () => ({
+  useSettings: () => mocks.settings,
+}));
+vi.mock('../ui/contexts/UIStateContext.js', () => ({
+  useUIState: () => mocks.ui,
+}));
+vi.mock('../ui/contexts/UIActionsContext.js', () => ({
+  useUIActions: () => mocks.actions,
+}));
+vi.mock('../ui/commands/contextCommand.js', () => ({
+  collectContextData: vi.fn(),
+}));
+vi.mock('../ui/hooks/useTerminalSize.js', () => ({
+  useTerminalSize: () => ({ rows: 40, columns: 100 }),
+}));
+vi.mock('../ui/context-menu/ContextMenuContext.js', () => ({
+  useContextMenu: () => ({ menu: null }),
+}));
+vi.mock('../ui/contexts/VirtualViewportContext.js', () => ({
+  useVirtualViewport: () => null,
+}));
+vi.mock('../ui/hooks/use-mouse-tracking-enabled.js', () => ({
+  useMouseTrackingEnabled: () => false,
+}));
+vi.mock('../ui/hooks/useMouseEvents.js', () => ({ useMouseEvents: vi.fn() }));
+
+describe('ModsHost submission ownership', () => {
+  let unmount: (() => void) | undefined;
+  const host = () => mocks.runtime.attach.mock.calls[0][0] as ModHost;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.ui.isConfigInitialized = true;
+    mocks.ui.shellModeActive = false;
+    mocks.ui.dialogsVisible = false;
+    mocks.ui.embeddedShellFocused = false;
+  });
+
+  afterEach(() => {
+    unmount?.();
+  });
+
+  it('rejects submission while the user views a subagent', async () => {
+    const view = render(<ModsHost activeMainSession={false} />);
+    unmount = view.unmount;
+    await vi.waitFor(() => expect(mocks.runtime.attach).toHaveBeenCalledOnce());
+    expect(() => host().submit('/help')).toThrow('Return to the main session');
+    expect(mocks.actions.handleFinalSubmit).not.toHaveBeenCalled();
+  });
+
+  it('uses the current active view without reattaching the runtime', async () => {
+    const view = render(<ModsHost activeMainSession={true} />);
+    unmount = view.unmount;
+    await vi.waitFor(() => expect(mocks.runtime.attach).toHaveBeenCalledOnce());
+    const attached = host();
+    attached.submit('/help');
+    expect(mocks.actions.handleFinalSubmit).toHaveBeenLastCalledWith('/help');
+    view.rerender(<ModsHost activeMainSession={false} />);
+    await vi.waitFor(() =>
+      expect(() => attached.submit('blocked')).toThrow(
+        'Return to the main session',
+      ),
+    );
+    view.rerender(<ModsHost activeMainSession={true} />);
+    await vi.waitFor(() =>
+      expect(() => attached.submit('main prompt')).not.toThrow(),
+    );
+    expect(mocks.actions.handleFinalSubmit).toHaveBeenLastCalledWith(
+      'main prompt',
+    );
+    expect(mocks.runtime.attach).toHaveBeenCalledOnce();
+    expect(mocks.actions.handleFinalSubmit).not.toHaveBeenCalledWith('blocked');
+  });
+
+  it.each([
+    'shellModeActive',
+    'dialogsVisible',
+    'embeddedShellFocused',
+  ] as const)('blocks submission when %s becomes active', async (field) => {
+    const view = render(<ModsHost activeMainSession={true} />);
+    unmount = view.unmount;
+    await vi.waitFor(() => expect(mocks.runtime.attach).toHaveBeenCalledOnce());
+    mocks.ui = { ...mocks.ui, [field]: true };
+    view.rerender(<ModsHost activeMainSession={true} />);
+    await vi.waitFor(() =>
+      expect(() => host().submit('/help')).toThrow('shell or dialog'),
+    );
+    expect(mocks.actions.handleFinalSubmit).not.toHaveBeenCalled();
+  });
+
+  it('defers attachment until configuration is initialized', async () => {
+    mocks.ui.isConfigInitialized = false;
+    const view = render(<ModsHost activeMainSession={true} />);
+    unmount = view.unmount;
