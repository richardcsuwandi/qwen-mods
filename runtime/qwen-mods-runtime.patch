+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { JsonStore } from './json-store.js';
+
+describe('JsonStore', () => {
+  let directory: string;
+  let file: string;
+  let store: JsonStore;
+
+  beforeEach(async () => {
+    directory = await mkdtemp(path.join(os.tmpdir(), 'qwen-mod-store-'));
+    file = path.join(directory, 'data.json');
+    store = new JsonStore(file);
+  });
+
+  afterEach(async () => {
+    await rm(directory, { recursive: true, force: true });
+  });
+
+  it('uses defaults only for absent keys and survives a new instance', async () => {
+    expect(await store.get('missing', 7)).toBe(7);
+    await store.set('false', false);
+    await store.set('null', null);
+    await store.set('nested', { values: [0, 'value'] });
+    const restarted = new JsonStore(file);
+    expect(await restarted.get('false', true)).toBe(false);
+    expect(await restarted.get('null', 7)).toBeNull();
+    expect(await restarted.get('nested', {})).toEqual({ values: [0, 'value'] });
+  });
+
+  it('does not lose parallel updates from separate instances', async () => {
+    await Promise.all(
+      Array.from({ length: 8 }, () =>
+        new JsonStore(file).update<number>('count', 0, (value) => value + 1),
+      ),
+    );
+    expect(await store.get('count', 0)).toBe(8);
+    expect(await readdir(directory)).toEqual(['data.json']);
+  });
+
+  it.each(['{bad json', '[]', 'null', '42', '"text"'])(
+    'preserves malformed store %s',
+    async (content) => {
+      await writeFile(file, content);
+      await expect(store.get('key', 0)).rejects.toThrow();
+      await expect(store.set('key', 1)).rejects.toThrow();
+      expect(await readFile(file, 'utf8')).toBe(content);
+      expect(await readdir(directory)).toEqual(['data.json']);
+    },
+  );
+
+  it('keeps the old file and releases the lock when an updater throws', async () => {
+    await store.set('count', 2);
+    const original = await readFile(file, 'utf8');
+    await expect(
+      store.update('count', 0, () => {
+        throw new Error('updater failed');
+      }),
+    ).rejects.toThrow('updater failed');
+    expect(await readFile(file, 'utf8')).toBe(original);
+    await store.update<number>('count', 0, (value) => value + 1);
+    expect(await store.get('count', 0)).toBe(3);
+  });
+
+  it('stores prototype-looking names as own JSON keys', async () => {
+    await store.set('__proto__', { safe: true });
+    await store.set('constructor', 1);
+    expect(await store.get('__proto__', null)).toEqual({ safe: true });
+    expect(await store.get('constructor', null)).toBe(1);
+    expect(Object.prototype).not.toHaveProperty('safe');
+  });
+});
