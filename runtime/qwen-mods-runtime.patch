+    view.rerender(<ModsHost activeMainSession={true} />);
+    await vi.waitFor(() => expect(mocks.runtime.attach).toHaveBeenCalledOnce());
+    host().submit('ready');
+    expect(mocks.actions.handleFinalSubmit).toHaveBeenCalledWith('ready');
+  });
