@@ -0,0 +1,229 @@
+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import * as React from 'react';
+import { Box, Text, type DOMElement } from 'ink';
+import { useConfig } from '../ui/contexts/ConfigContext.js';
+import { useSettings } from '../ui/contexts/SettingsContext.js';
+import { useUIState } from '../ui/contexts/UIStateContext.js';
+import { useUIActions } from '../ui/contexts/UIActionsContext.js';
+import { useTerminalSize } from '../ui/hooks/useTerminalSize.js';
+import { useContextMenu } from '../ui/context-menu/ContextMenuContext.js';
+import { useVirtualViewport } from '../ui/contexts/VirtualViewportContext.js';
+import { useMouseTrackingEnabled } from '../ui/hooks/use-mouse-tracking-enabled.js';
+import { useMouseEvents } from '../ui/hooks/useMouseEvents.js';
+import { findElementAtMouseEvent } from '../ui/utils/mouse-hit.js';
+import { StreamingState } from '../ui/types.js';
+import { collectContextData } from '../ui/commands/contextCommand.js';
+import { calculateCost } from '../utils/costCalculator.js';
+import { getModRuntime } from './runtime.js';
+import type { ModSession, ModSlot } from './api.js';
+
+function ModButton({ label, onPress }: { label: string; onPress: () => void }) {
+  const ref = React.useRef<DOMElement>(null);
+  const { rows } = useTerminalSize();
+  const { menu } = useContextMenu();
+  const enabled = useMouseTrackingEnabled();
+  const viewport = useVirtualViewport();
+  useMouseEvents(
+    (event) => {
+      if (
+        event.name === 'left-press' &&
+        findElementAtMouseEvent(
+          ref.current,
+          [ref.current],
+          event,
+          rows,
+          'rect',
+        ) !== null
+      )
+        onPress();
+    },
+    { isActive: enabled && !!viewport && menu === null, tracking: 'button' },
+  );
+  return (
+    <Box ref={ref}>
+      <Text color="cyan">[{label}]</Text>
+    </Box>
+  );
+}
+
+export function ModsHost({
+  activeMainSession,
+}: {
+  activeMainSession: boolean;
+}) {
+  const config = useConfig();
+  const settings = useSettings();
+  const ui = useUIState();
+  const actions = useUIActions();
+  const runtime = getModRuntime(config);
+  const latest = React.useRef({ ui, actions, activeMainSession });
+  latest.current = { ui, actions, activeMainSession };
+  let inputTokens = 0;
+  let outputTokens = 0;
+  let cost = 0;
+  let priced = false;
+  let costIsPartial = false;
+  for (const [model, metrics] of Object.entries(
+    ui.sessionStats.metrics.models,
+  )) {
+    const input = metrics.tokens.prompt;
+    const output = metrics.tokens.candidates;
+    inputTokens += input;
+    outputTokens += output;
+    if (input <= 0 && output <= 0) continue;
+    const pricing = settings.merged.modelPricing?.[model];
+    const estimate = calculateCost({
+      inputTokens: input,
+      outputTokens: output,
+      pricing,
+    });
+    if (estimate !== null && Number.isFinite(estimate)) {
+      cost += estimate;
+      priced = true;
+    }
+    if (
+      estimate === null ||
+      (input > 0 && pricing?.inputPerMillionTokens == null) ||
+      (output > 0 && pricing?.outputPerMillionTokens == null)
+    )
+      costIsPartial = true;
+  }
+  const snapshot: ModSession = {
+    id: ui.sessionStats.sessionId,
+    model: ui.currentModel,
+    cwd: config.getTargetDir(),
+    busy: ui.streamingState !== StreamingState.Idle,
+    promptTokens: ui.sessionStats.lastPromptTokenCount,
+    contextWindow:
+      config.getContentGeneratorConfig()?.contextWindowSize ?? null,
+    inputTokens,
+    outputTokens,
+    cost: priced ? cost : null,
+    costIsPartial,
+    historyLength: ui.history.length,
+  };
+  const snapshotRef = React.useRef(snapshot);
+  snapshotRef.current = snapshot;
+
+  React.useEffect(() => {
+    if (!ui.isConfigInitialized) return;
+    runtime.attach({
+      ui: { React, Box, Text, Button: ModButton },
+      submit: (text) => {
+        if (!latest.current.activeMainSession)
+          throw new Error(
+            'Return to the main session before a mod submits a prompt or command',
+          );
+        const state = latest.current.ui;
+        if (
+          state.shellModeActive ||
+          state.dialogsVisible ||
+          state.embeddedShellFocused
+        )
+          throw new Error(
+            'Mod submission is unavailable while a shell or dialog is active',
+          );
+        latest.current.actions.handleFinalSubmit(text);
+      },
+      notify: (text, level) => {
+        latest.current.ui.commandContext.ui.addItem(
+          { type: level, text },
+          Date.now(),
+        );
+      },
+      commandsChanged: () => {
+        void latest.current.actions.reloadCommands();
+      },
+      context: async () => {
+        const data = await collectContextData(config, false);
+        const b = data.breakdown;
+        const categories = [
+          { name: 'System prompt', tokens: b.systemPrompt },
+          { name: 'Tools', tokens: b.builtinTools + b.mcpTools },
+          { name: 'Memory', tokens: b.memoryFiles },
+          { name: 'Skills', tokens: b.skills },
+          { name: 'Startup', tokens: b.startupContext ?? 0 },
+          { name: 'Messages', tokens: b.messages },
+          { name: 'Other', tokens: b.unattributed ?? 0 },
+        ];
+        return {
+          used: categories.reduce((sum, c) => sum + c.tokens, 0),
+          window: data.contextWindowSize,
+          estimated: data.isEstimated ?? false,
+          reserve: b.autocompactBuffer,
+          categories,
+        };
+      },
+    });
+    runtime.updateSession(snapshotRef.current);
+    void runtime.start();
+    return () => runtime.dispose();
+  }, [config, runtime, ui.isConfigInitialized]);
+
+  React.useEffect(() => {
+    if (ui.isConfigInitialized) runtime.updateSession(snapshotRef.current);
+  });
+  return null;
+}
+
+class ModViewBoundary extends React.Component<
+  { children: React.ReactNode },
+  { error: string | null }
+> {
+  override state = { error: null as string | null };
+  static getDerivedStateFromError(error: Error) {
+    return { error: error.message };
+  }
+  override render() {
+    return this.state.error ? (
+      <Text color="red">
+        Mod view failed: {this.state.error}. Reload the mod to retry.
+      </Text>
+    ) : (
+      this.props.children
+    );
+  }
+}
+
+export function ModsSlot({
+  slot,
+  availableWidth,
+}: {
+  slot: ModSlot;
+  availableWidth?: number;
+}) {
+  const runtime = getModRuntime(useConfig());
+  const ui = useUIState();
+  const { columns } = useTerminalSize();
+  React.useSyncExternalStore(runtime.subscribe, runtime.getRevision);
+  if (
+    !ui.isConfigInitialized ||
+    !ui.isInputActive ||
+    ui.embeddedShellFocused ||
+    ui.dialogsVisible
+  )
+    return null;
+  const views = runtime.getViews(slot);
+  if (!views.length) return null;
+  const width = Math.max(
+    1,
+    Math.min(
+      Math.min(columns, ui.mainAreaWidth || columns) - 4,
+      availableWidth ?? columns,
+    ),
+  );
+  return (
+    <Box flexDirection="column" paddingX={slot === 'footer' ? 0 : 2}>
+      {views.map(({ component: Component, key }) => (
+        <ModViewBoundary key={key}>
+          <Component session={runtime.getSession()} width={width} />
+        </ModViewBoundary>
+      ))}
+    </Box>
+  );
+}
