+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type * as React from 'react';
+import type { Box, Text } from 'ink';
+import type { Config } from '@qwen-code/qwen-code-core';
+import type {
+  FunctionHookCallback,
+  HookEventName,
+} from '@qwen-code/qwen-code-core/hooks/types.js';
+
+export type Dispose = () => void;
+export type Json =
+  | null
+  | boolean
+  | number
+  | string
+  | Json[]
+  | { [key: string]: Json };
+export type ModEvent =
+  | 'session.start'
+  | 'session.end'
+  | 'session.update'
+  | 'turn.start'
+  | 'turn.end';
+export type ModSlot = 'abovePrompt' | 'belowPrompt' | 'footer';
+
+export interface ModSession {
+  id: string;
+  model: string;
+  cwd: string;
+  busy: boolean;
+  promptTokens: number;
+  contextWindow: number | null;
+  inputTokens: number;
+  outputTokens: number;
+  cost: number | null;
+  costIsPartial: boolean;
+  historyLength: number;
+}
+
+export interface ModContext {
+  used: number;
+  window: number;
+  estimated: boolean;
+  reserve: number;
+  categories: Array<{ name: string; tokens: number }>;
+}
+
+export interface ModViewProps {
+  session: Readonly<ModSession>;
+  width: number;
+}
+
+/** API version 1. Modules execute as trusted Node.js code, without a sandbox. */
+export interface QwenModAPI {
+  readonly version: 1;
+  readonly id: string;
+  readonly directory: string;
+  readonly signal: AbortSignal;
+  command(
+    name: string,
+    description: string,
+    handler: (args: string) => string | void | Promise<string | void>,
+  ): Dispose;
+  runCommand(name: string, args?: string): void;
+  prompt(text: string): void;
+  on(
+    event: ModEvent,
+    listener: (session: Readonly<ModSession>) => void | Promise<void>,
+  ): Dispose;
+  hook(
+    event: HookEventName | `${HookEventName}`,
+    callback: FunctionHookCallback,
+    options?: { matcher?: string; timeout?: number },
+  ): Dispose;
+  session: {
+    get(): Readonly<ModSession>;
+    context(): Promise<ModContext>;
+  };
+  state: {
+    get<T>(key: string, fallback: T): T;
+    set<T>(key: string, value: T): void;
+  };
+  store: {
+    get<T extends Json>(key: string, fallback: T): Promise<T>;
+    set(key: string, value: Json): Promise<void>;
+    update<T extends Json>(
+      key: string,
+      fallback: T,
+      change: (value: T) => T,
+    ): Promise<T>;
+  };
+  ui: {
+    React: typeof React;
+    Box: typeof Box;
+    Text: typeof Text;
+    Button: React.ComponentType<{ label: string; onPress: () => void }>;
+    slot(slot: ModSlot, component: React.ComponentType<ModViewProps>): Dispose;
+    notify(text: string, level?: 'info' | 'warning' | 'error'): void;
+    invalidate(): void;
+  };
+  timers: {
+    every(ms: number, callback: () => void | Promise<void>): Dispose;
+  };
+  http: {
+    fetch(url: string | URL, options?: RequestInit): Promise<Response>;
+  };
+  process: {
+    run(
+      file: string,
+      args?: string[],
+      options?: { cwd?: string; timeout?: number },
+    ): Promise<{ stdout: string; stderr: string }>;
+  };
+  /** Qwen internals may change independently of the versioned mod API. */
+  experimental: { config: Config };
+}
+
+export interface QwenModModule {
+  register(api: QwenModAPI): void | Dispose | Promise<void | Dispose>;
+}
+
+export interface ModManifest {
+  id: string;
+  name?: string;
+  apiVersion: 1;
+  entry: string;
+}
