+/**
+ * @license
+ * Copyright 2026 Qwen
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Config } from '@qwen-code/qwen-code-core';
+import { CommandService } from '../services/CommandService.js';
+import {
+  CommandKind,
+  type CommandContext,
+  type SlashCommand,
+} from '../ui/commands/types.js';
+import { ModCommandLoader } from './command-loader.js';
+
+const mocks = vi.hoisted(() => ({ manage: vi.fn(), getCommands: vi.fn() }));
+vi.mock('./runtime.js', () => ({ getModRuntime: () => mocks }));
+vi.mock('@qwen-code/qwen-code-core', () => ({
+  createDebugLogger: () => ({ debug: vi.fn(), warn: vi.fn() }),
+}));
+
+describe('ModCommandLoader', () => {
+  const config = {} as Config;
+  const signal = new AbortController().signal;
+  const loader = new ModCommandLoader(config);
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.manage.mockResolvedValue('done');
+    mocks.getCommands.mockReturnValue([]);
+  });
+
+  it.each([
+    ['', 'list', ''],
+    [' list ', 'list', ''],
+    ['load /tmp/my mod', 'load', '/tmp/my mod'],
+    ['enable "/tmp/my mod"', 'enable', '/tmp/my mod'],
+    ["load '/tmp/my mod'", 'load', '/tmp/my mod'],
+    ['reload fourth-mod', 'reload', 'fourth-mod'],
+    ['disable fourth-mod', 'disable', 'fourth-mod'],
+  ])(
+    'parses %j into its lifecycle action and argument',
+    async (input, action, argument) => {
+      const [command] = await loader.loadCommands(signal);
+      expect(await command.action!({} as CommandContext, input)).toEqual({
+        type: 'message',
+        messageType: 'info',
+        content: 'done',
+      });
+      expect(mocks.manage).toHaveBeenCalledWith(action, argument);
+    },
+  );
+
+  it('returns runtime failures as local errors', async () => {
+    mocks.manage.mockRejectedValue(new Error('Unknown mods action: nope'));
+    const [command] = await loader.loadCommands(signal);
+    expect(await command.action!({} as CommandContext, 'nope id')).toEqual({
+      type: 'message',
+      messageType: 'error',
+      content: 'Unknown mods action: nope',
+    });
+  });
+
+  it('does not load without config or after abort', async () => {
+    expect(await new ModCommandLoader(null).loadCommands(signal)).toEqual([]);
+    expect(await loader.loadCommands(AbortSignal.abort())).toEqual([]);
+    expect(mocks.getCommands).not.toHaveBeenCalled();
+  });
+
+  it('preserves built-in commands and applies collision and disable rules', async () => {
+    const builtIn: SlashCommand = {
+      name: 'help',
+      description: 'Built-in help',
+      kind: CommandKind.BUILT_IN,
+      action: vi.fn(),
+    };
+    const mod: SlashCommand = {
+      name: 'help',
+      description: 'Mod help',
+      kind: CommandKind.BUILT_IN,
+      extensionName: 'fourth-mod',
+      supportedModes: ['interactive'],
+      modelInvocable: false,
+      action: vi.fn(),
+    };
+    mocks.getCommands.mockReturnValue([mod]);
+    const loaders = [{ loadCommands: async () => [builtIn] }, loader];
+    const service = await CommandService.create(loaders, signal);
+    expect(service.getCommands().map(({ name }) => name)).toEqual([
+      'help',
+      'mods',
+      'fourth-mod.help',
+    ]);
+    expect(service.getCommands()[0].action).toBe(builtIn.action);
+    expect(service.getCommands()[2].action).toBe(mod.action);
+    expect(service.getModelInvocableCommands()).toEqual([]);
+    expect(
+      service.getCommandsForMode('non_interactive').map(({ name }) => name),
+    ).not.toContain('mods');
+    const disabled = await CommandService.create(
+      loaders,
+      signal,
+      new Set([' MODS ', 'FOURTH-MOD.HELP']),
+    );
+    expect(disabled.getCommands().map(({ name }) => name)).toEqual(['help']);
+  });
+});
